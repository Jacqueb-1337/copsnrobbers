{
  "schemaVersion": 1,
  "id": "cnrmapexporter",
  "version": "${version}",
  "name": "CNR Map Exporter",
  "description": "Exports Minecraft builds and selections as compact Cops N Robbers DLC map packages, including textures, collision, spawns, and climbable surfaces.",
  "authors": ["Jacqueb"],
  "contact": {
    "homepage": "https://play.jacqueb.me/",
    "sources": "https://github.com/Jacqueb-1337/copsnrobbers",
    "issues": "https://github.com/Jacqueb-1337/copsnrobbers/issues"
  },
  "license": "CC0-1.0",
  "icon": "assets/cnrmapexporter/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["me.jacqueb.cnrmapexporter.CnrMapExporterClient"]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}

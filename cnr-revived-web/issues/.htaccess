# Block direct access to sensitive files
<FilesMatch "\.(db|db-wal|db-shm|php)$">
  <IfModule mod_authz_core.c>
    # Apache 2.4+
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    # Apache 2.2
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# But allow the PHP entry points
<FilesMatch "^(api|unsubscribe|view|login)\.php$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Allow from all
  </IfModule>
</FilesMatch>

# Protect .env files explicitly
<Files ".env">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</Files>

# Prevent directory listing
Options -Indexes

# No caching for API responses (handled via header in PHP, but belt-and-braces)
<FilesMatch "^api\.php$">
  Header set Cache-Control "no-store, no-cache, must-revalidate"
</FilesMatch>

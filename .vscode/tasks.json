{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CNR: Build & Release (interactive)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoLogo",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}\\build_and_release.ps1"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "CNR: Quick patch (CNRMod, deploy + commit)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoLogo",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}\\build_and_release.ps1",
                "-ModName", "CNRMod",
                "-Bump", "patch",
                "-UpdateRepo",
                "-Deploy",
                "-Commit"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "CNR: Build only (no bump, no deploy, no commit)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoLogo",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}\\build_and_release.ps1",
                "-NoBump",
                "-NoRepo",
                "-NoDeploy",
                "-NoCommit"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": [],
            "group": "build"
        }
    ]
}
